{
  "name": "autovd-cypress-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable Cypress TypeScript test framework",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "test": "cypress run",
    "test:smoke": "cypress run --expose grepTags=@smoke",
    "test:open": "cypress open",
    "test:headed": "cypress run --headed",
    "type-check": "tsc --noEmit",
    "lint": "eslint cypress cypress.config.ts",
    "lint:fix": "eslint cypress cypress.config.ts --fix",
    "format": "prettier --write \"cypress/**/*.ts\" \"cypress.config.ts\" \"eslint.config.mjs\" \"package.json\" \"tsconfig.json\"",
    "format:check": "prettier --check \"cypress/**/*.ts\" \"cypress.config.ts\" \"eslint.config.mjs\" \"package.json\" \"tsconfig.json\"",
    "verify": "npm run type-check && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "cypress": "^16.2.1",
    "cypress-mochawesome-reporter": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
